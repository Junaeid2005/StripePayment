# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# STRIPE_SECRET_KEY: Server-side Stripe secret or restricted key (never expose to client).
STRIPE_SECRET_KEY="rk_live_YOUR_STRIPE_RESTRICTED_OR_SECRET_KEY"

# STRIPE_PUBLISHABLE_KEY: Stripe publishable key used to initialize Stripe Checkout.
STRIPE_PUBLISHABLE_KEY="pk_live_YOUR_STRIPE_PUBLISHABLE_KEY"
